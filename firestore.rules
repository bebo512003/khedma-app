rules_version = '2';

// مدرسة الشهيد اسطفانوس للشمامسة
// Servants sign in with Google and must be listed under churches/{c}/servants.
// Members sign in with code + PIN (email/password under the hood) and can read only their own published view.
service cloud.firestore {
  match /databases/{database}/documents {
    match /churches/{c} {
      function doc(coll, id) { return /databases/$(database)/documents/churches/$(c)/$(coll)/$(id); }
      function signedIn() { return request.auth != null; }
      function google() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com'; }
      function email() { return request.auth.token.email.lower(); }
      function servant() { return google() && exists(doc('servants', request.auth.uid)); }
      function me() { return get(doc('servants', request.auth.uid)).data; }
      // admin: runs the team. lead: runs the school. servant: only the permissions the admin ticked.
      function admin() { return servant() && me().role == 'admin'; }
      function lead() { return servant() && me().role in ['admin', 'lead']; }
      // Servants from before permissions existed have no perms field and keep every permission.
      function can(p) { return lead() || (servant() && (!('perms' in me()) || me().perms.hasAny([p]))); }
      function church() { return get(/databases/$(database)/documents/churches/$(c)).data; }
      function canLevel(l) { return me().levelIds.hasAny(['*', l]); }
      // A member's record and view belong to their level: servants change only the levels they serve.
      function levelOf(id) { return get(doc('members', id)).data.get('levelId', ''); }
      function member() { return signedIn() && exists(doc('accounts', request.auth.uid)); }
      function myMember(id) { return signedIn() && get(doc('accounts', request.auth.uid)).data.memberId == id; }
      function str(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
      function phone(d, k) { return !(k in d) || (d[k] is string && d[k].matches('^[+0-9 -]{0,20}$')); }
      function day(d, k) { return !(k in d) || (d[k] is string && d[k].matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')); }
      function img(d, k) { return !(k in d) || (d[k] is string && d[k].size() < 100000 && d[k].matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')); }

      allow get: if signedIn();
      // The first servant starts the church and becomes its owner.
      allow create: if google() && c == 'stephanos-darwa' && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'createdAt']);
      allow update: if lead();

      match /servants/{uid} {
        allow read: if servant() || (signedIn() && request.auth.uid == uid);
        allow create: if admin() || (google() && request.auth.uid == uid && (
          (church().ownerUid == uid && request.resource.data.role in ['admin', 'lead'])
          || (exists(doc('invites', email()))
              && request.resource.data.role == get(doc('invites', email())).data.role
              && request.resource.data.levelIds == get(doc('invites', email())).data.levelIds
              && request.resource.data.get('perms', null) == get(doc('invites', email())).data.get('perms', null))));
        // The founder upgrades their own record to admin.
        allow update: if admin() || (servant() && request.auth.uid == uid && church().ownerUid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) && request.resource.data.role == 'admin')
          || (servant() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photo', 'phone', 'birthdate', 'rank', 'about'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && img(request.resource.data, 'photo') && phone(request.resource.data, 'phone') && day(request.resource.data, 'birthdate')
          && str(request.resource.data, 'rank', 30) && str(request.resource.data, 'about', 300));
        allow delete: if admin();
      }

      match /invites/{inviteEmail} {
        allow get: if servant() || (google() && email() == inviteEmail);
        allow list: if servant();
        allow create, update: if admin();
        allow delete: if admin() || (google() && email() == inviteEmail);
      }

      // code → how many times the PIN was reset; needed before sign-in, holds nothing private.
      match /logins/{code} {
        allow get: if true;
        allow write: if servant();
      }

      // A login for a member: only a servant of that member's level makes or retires it.
      match /accounts/{uid} {
        allow get: if (signedIn() && request.auth.uid == uid) || servant();
        allow list: if servant();
        allow create, update: if can('members') && request.resource.data.keys().hasOnly(['memberId'])
          && request.resource.data.memberId is string && canLevel(levelOf(request.resource.data.memberId));
        allow delete: if can('members') && canLevel(levelOf(resource.data.memberId));
      }

      match /memberViews/{memberId} {
        allow get: if servant() || myMember(memberId);
        allow list: if servant();
        allow create, update: if servant() && request.resource.data.memberId == memberId && canLevel(request.resource.data.get('levelId', ''));
        allow delete: if servant() && canLevel(resource.data.get('levelId', ''));
      }

      // A servant can record sessions only for the levels the lead gave them.
      match /sessions/{id} {
        allow read: if servant();
        allow create: if can('sessions') && canLevel(request.resource.data.levelId);
        // Both levels: a servant can't pull another level's session into theirs.
        allow update: if can('sessions') && canLevel(resource.data.levelId) && canLevel(request.resource.data.levelId);
        allow delete: if can('sessions') && canLevel(resource.data.levelId);
      }

      // A member's edit of their own photo and details; a servant's app copies it into the member record.
      match /memberEdits/{memberId} {
        allow read, delete: if servant();
        allow get: if myMember(memberId);
        allow create, update: if myMember(memberId)
          && request.resource.data.keys().hasOnly(['name', 'photo', 'birthdate', 'phone', 'parentPhone', 'gender', 'grade', 'address', 'at'])
          && (!('gender' in request.resource.data) || request.resource.data.gender in ['m', 'f'])
          && str(request.resource.data, 'grade', 30) && str(request.resource.data, 'address', 200)
          && str(request.resource.data, 'name', 80) && img(request.resource.data, 'photo') && day(request.resource.data, 'birthdate')
          && phone(request.resource.data, 'phone') && phone(request.resource.data, 'parentPhone')
          && (!('at' in request.resource.data) || request.resource.data.at is number);
      }

      // Pages of uploaded booklets (images only). Open to anyone, like the books themselves (the open book library).
      match /bookPages/{id} {
        allow read: if true;
        allow write: if can('curriculum');
      }

      // Levels, terms and removing members are the lead's call.
      match /levels/{id} { allow read: if true; allow write: if lead(); }
      match /terms/{id} { allow read: if servant(); allow write: if lead(); }
      match /members/{id} {
        allow read: if servant();
        allow create: if can('members') && canLevel(request.resource.data.get('levelId', ''));
        // Moving a member to another level needs both levels.
        allow update: if can('members') && canLevel(resource.data.get('levelId', '')) && canLevel(request.resource.data.get('levelId', ''));
        allow delete: if lead();
      }

      // Reminder schedule (lead edits) and what the scheduled job last sent (only it writes).
      match /settings/{id} {
        allow read: if servant();
        allow write: if lead() && id == 'notify';
      }

      // This phone's Web Push address, saved by whoever signed in on it. Only the scheduled job reads them all.
      match /pushSubs/{id} {
        allow get, delete: if signedIn() && resource.data.uid == request.auth.uid;
        allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'endpoint', 'p256dh', 'auth', 'at'])
          && request.resource.data.endpoint is string && request.resource.data.endpoint.size() < 1000
          && request.resource.data.endpoint.matches('^https://.*')
          && str(request.resource.data, 'p256dh', 200) && str(request.resource.data, 'auth', 100);
      }

      // Voice summaries of sessions, split into pieces under 1 MB. Members play them from their app.
      // Members may add only their own home recordings (named sub_<their code>_…), each piece under 1 MB.
      match /recordings/{id} {
        // Members fetch pieces one by one (no listing), and of the home recordings only their own.
        allow read: if servant();
        allow get: if member() && (!id.matches('sub_.*') || id.matches('sub_' + get(doc('accounts', request.auth.uid)).data.memberId + '_.*'));
        allow write: if can('sessions');
        allow create: if member() && id.matches('sub_' + get(doc('accounts', request.auth.uid)).data.memberId + '_[a-z0-9]+-[0-2]')
          && request.resource.data.keys().hasOnly(['data', 'i', 'parts', 'mime'])
          && request.resource.data.data is bytes && request.resource.data.data.size() <= 700000
          && request.resource.data.parts is int && request.resource.data.parts <= 3;
      }

      // «سمّع للخادم»: a member sends a hymn recording; a servant listens and replies with a level and a note.
      match /submissions/{id} {
        function mine() { return get(doc('accounts', request.auth.uid)).data.memberId; }
        allow read: if servant() || (member() && resource.data.memberId == mine());
        allow create: if member() && request.resource.data.memberId == mine()
          && id.matches(mine() + '_[0-9]+') && request.resource.data.levelId == levelOf(mine())
          && request.resource.data.keys().hasOnly(['id', 'memberId', 'memberName', 'levelId', 'hymnId', 'hymnName', 'recording', 'at', 'pending'])
          && request.resource.data.pending == true && request.resource.data.id == id
          && request.resource.data.at is int && request.resource.data.at <= request.time.toMillis() + 600000
          && str(request.resource.data, 'memberName', 80) && str(request.resource.data, 'hymnName', 120)
          && str(request.resource.data, 'levelId', 40) && str(request.resource.data, 'hymnId', 80)
          && request.resource.data.recording.id.matches('sub_' + mine() + '_[a-z0-9]+')
          && request.resource.data.recording.parts is int && request.resource.data.recording.parts <= 3;
        allow update: if can('sessions') && canLevel(resource.data.levelId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pending', 'review', 'reviewAt', 'recording']);
        allow delete: if lead();
      }

      // The hymn library is open to anyone (#/open/library), signed in or not.
      match /hymns/{id} { allow read: if true; allow write: if can('curriculum'); }
      match /books/{id} { allow read: if true; allow write: if can('curriculum'); }
      match /progress/{id} { allow read, write: if servant(); }
      // meta also holds the next member code and message templates, which any servant may change; the curriculum needs the permission.
      match /meta/{id} {
        allow read: if servant();
        allow write: if can('curriculum') || (servant() && resource != null && request.resource.data.get('curricula', null) == resource.data.get('curricula', null));
      }
    }
  }
}
